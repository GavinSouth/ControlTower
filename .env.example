# Copy to .env and fill in. Never commit .env.
# OpenSky Network API client credentials: https://opensky-network.org (Account → API client)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Optional tuning (defaults in backend/src/controltower/config.py, rationale in docs/ARCHITECTURE.md)
# OPENSKY_DAILY_CREDITS=4000        # 400 anonymous, 4000 free account, 8000 feeder
# CREDIT_RESERVE_FRACTION=0.1
# POLL_BBOX=                        # "lat_min,lon_min,lat_max,lon_max"; empty = global
# IDLE_PAUSE_S=600
# STALE_AFTER_S=60
